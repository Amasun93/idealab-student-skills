{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ideaLab D3 Visual Preparation",
  "type": "object",
  "required": ["schema_version", "project_title", "source_opening_book", "uses_ai", "concept", "flow", "hardware"],
  "properties": {
    "schema_version": { "const": 1 },
    "project_title": { "type": "string", "minLength": 1, "maxLength": 60 },
    "source_opening_book": { "type": "string", "minLength": 1 },
    "uses_ai": { "type": "boolean" },
    "concept": {
      "type": "object",
      "required": ["output", "origin", "attempt", "review_status", "description", "quality_checks"],
      "properties": {
        "output": { "type": "string", "minLength": 1 },
        "origin": { "enum": ["ai-generated", "student-handdrawn", "opening-book-reference"] },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 2 },
        "review_status": { "enum": ["approved", "fallback-handdrawn", "fallback-opening-book"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 160 },
        "quality_checks": {
          "type": "object",
          "required": ["physical_product", "user_or_hand", "usage_scene", "interaction_visible", "matches_opening_book", "clear_image"],
          "properties": {
            "physical_product": { "type": "boolean" },
            "user_or_hand": { "type": "boolean" },
            "usage_scene": { "type": "boolean" },
            "interaction_visible": { "type": "boolean" },
            "matches_opening_book": { "type": "boolean" },
            "clear_image": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "reference_images": {
          "type": "array",
          "maxItems": 4,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "flow": {
      "type": "object",
      "required": ["output", "student_retelling", "modes"],
      "properties": {
        "output": { "type": "string", "minLength": 1 },
        "student_retelling": { "type": "string", "minLength": 1, "maxLength": 500 },
        "modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["name", "steps"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 24 },
              "steps": {
                "type": "array",
                "minItems": 2,
                "maxItems": 12,
                "items": { "type": "string", "minLength": 1, "maxLength": 50 }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "hardware": {
      "type": "object",
      "required": ["output", "controller", "sensors", "actuators", "power", "communication", "ai"],
      "properties": {
        "output": { "type": "string", "minLength": 1 },
        "controller": { "$ref": "#/$defs/module" },
        "sensors": { "$ref": "#/$defs/modules" },
        "actuators": { "$ref": "#/$defs/modules" },
        "power": { "$ref": "#/$defs/modules" },
        "communication": { "$ref": "#/$defs/modules" },
        "ai": { "$ref": "#/$defs/aiModules" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "required": ["name", "purpose"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 30 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 80 }
      },
      "additionalProperties": false
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/module" }
    },
    "aiModules": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["name", "input", "purpose", "output", "runtime"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 30 },
          "input": { "type": "string", "minLength": 1, "maxLength": 80 },
          "purpose": { "type": "string", "minLength": 1, "maxLength": 80 },
          "output": { "type": "string", "minLength": 1, "maxLength": 80 },
          "runtime": { "type": "string", "minLength": 1, "maxLength": 40 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
