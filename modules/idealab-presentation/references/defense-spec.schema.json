{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ideaLab Presentation Spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_confirmed", "meta", "slides", "existing_solutions", "experiments", "qa"],
  "properties": {
    "schema_version": { "const": 1 },
    "plan_confirmed": { "const": true },
    "meta": {
      "type": "object",
      "required": ["student_name", "project_title", "project_short_name", "grade_band", "core_problem", "archive_root"],
      "properties": {
        "student_name": { "type": "string", "minLength": 1 },
        "project_title": { "type": "string", "minLength": 1 },
        "project_short_name": { "type": "string", "minLength": 1 },
        "grade_band": { "enum": ["primary", "middle", "high"] },
        "core_problem": { "type": "string", "minLength": 1 },
        "archive_root": { "type": "string" }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["section", "title", "notes"],
        "properties": {
          "section": { "type": "string" },
          "kicker": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" },
          "logic_link": { "type": "string" },
          "bullets": { "type": "array", "items": { "type": "string" } },
          "source_refs": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string", "minLength": 1 },
          "transition": { "type": "string" },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["status", "label"],
              "properties": {
                "status": { "enum": ["present", "missing", "generated", "not-applicable"] },
                "src": { "type": "string" },
                "label": { "type": "string", "minLength": 1 },
                "caption": { "type": "string" },
                "needed": { "type": "string" },
                "requested_from": { "type": "string" }
              }
            }
          },
          "videos": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "object",
              "required": ["status", "label"],
              "properties": {
                "status": { "enum": ["present", "missing", "not-applicable"] },
                "src": { "type": "string" },
                "role": { "const": "student-demo" },
                "label": { "type": "string", "minLength": 1 },
                "caption": { "type": "string" },
                "needed": { "type": "string" },
                "requested_from": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "existing_solutions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["name", "source_ref", "strength", "limitation", "project_advantage"],
        "properties": {
          "name": { "type": "string" },
          "source_ref": { "type": "string", "minLength": 1 },
          "source_url": { "type": "string" },
          "solution": { "type": "string" },
          "strength": { "type": "string", "minLength": 1 },
          "limitation": { "type": "string", "minLength": 1 },
          "project_advantage": { "type": "string", "minLength": 1 }
        }
      }
    },
    "experiments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "status", "purpose", "method"],
        "properties": {
          "type": { "enum": ["functional", "effectiveness", "performance"] },
          "status": { "enum": ["documented", "interview-confirmed", "planned"] },
          "purpose": { "type": "string" },
          "method": { "type": "string" },
          "result": { "type": "string" },
          "numeric_result": {}
        }
      }
    },
    "qa": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["question", "answer"],
        "properties": {
          "category": { "type": "string" },
          "question": { "type": "string", "minLength": 1 },
          "answer": { "type": "string", "minLength": 1 },
          "source_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
